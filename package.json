{
  "name": "fdd-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fdd/web",
    "build": "npm run build -w @fdd/web",
    "preview": "npm run preview -w @fdd/web",
