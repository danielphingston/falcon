{
 "tools": [
  {
   "name": "get_today",
   "description": "Today's briefing: overdue and due-today items, IRL items and follow-ups to chase today (grouped by person), work papers waiting for my review, and open review points on my own work papers.",
   "inputSchema": {
    "type": "object",
    "properties": {}
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false
   }
  },
  {
   "name": "search",
   "description": "Find records by text across engagements, tasks, work papers, review points, RFI items, work plan steps, follow-ups and people. Returns ids for use with other tools.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "Text to look for; empty string lists everything in the chosen tables"
     },
     "tables": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "people",
        "engagements",
        "workstreams",
        "tasks",
        "workpapers",
        "reviewPoints",
        "infoRequests",
        "followUps",
        "alerts",
        "timeEntries",
        "days",
        "achievements",
        "trialBalances",
        "programItems",
        "planItems"
       ]
      }
     },
     "includeDone": {
      "description": "Include done/cleared/received/closed items",
      "type": "boolean"
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     }
    },
    "required": [
     "query"
    ]
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false
   }
  },
  {
   "name": "create_engagement",
   "description": "Create an engagement/assignment (e.g. a deal code name like 'Project Falcon', or a client name) with its type, status, lead and team. For a whole team allocation sheet, call this once per assignment (or update_engagement if it already exists).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "type": {
      "description": "e.g. Due Diligence, Transaction Support, Stat Audit, Internal Audit, ITR",
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "active",
       "on_hold",
       "closed"
      ]
     },
     "client": {
      "description": "Target or client company",
      "type": "string"
     },
     "side": {
      "type": "string",
      "enum": [
       "buy",
       "sell",
       "other"
      ]
     },
     "lead": {
      "description": "Who leads it; omit or 'me' when the user leads it",
      "type": "string"
     },
     "team": {
      "description": "Team member names; new names become team contacts",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "workstreams": {
      "description": "e.g. QoE, NWC, Net debt, Tax",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "draftReport": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "finalReport": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "timesheetCode": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "update_engagement",
   "description": "Change an engagement's status, type, lead, team, dates or details. `team` replaces the whole team; use addToTeam/removeFromTeam for single changes.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "engagement": {
      "type": "string",
      "description": "Engagement id or name"
     },
     "status": {
      "type": "string",
      "enum": [
       "active",
       "on_hold",
       "closed"
      ]
     },
     "type": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "client": {
      "type": "string"
     },
     "lead": {
      "description": "New lead's name, or 'me'",
      "type": "string"
     },
     "team": {
      "description": "Full team (names), replacing the current one",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "addToTeam": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "removeFromTeam": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "draftReport": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "finalReport": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "notes": {
      "type": "string"
     }
    },
    "required": [
     "engagement"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "add_person",
   "description": "Add a contact: a client contact, manager, partner or team member.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "enum": [
       "client",
       "manager",
       "partner",
       "team",
       "other"
      ]
     },
     "org": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "role"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "create_task",
   "description": "Create a to-do, call or meeting. When the user gives a time (\"call Rahul at 3pm\", \"review meeting 10:30-11:30\"), set due AND time (and durationMinutes if an end time or length is given): it is then added to their Google Calendar at that time with a reminder. Assign it to a team member to track work you've pushed to them.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "engagement": {
      "description": "Engagement id or name",
      "type": "string"
     },
     "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "time": {
      "description": "Start time, 24h HH:mm, e.g. 15:00. Requires due.",
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
     },
     "durationMinutes": {
      "description": "Length in minutes; default 30",
      "type": "integer",
      "minimum": 5,
      "maximum": 1440
     },
     "priority": {
      "type": "string",
      "enum": [
       "low",
       "normal",
       "high"
      ]
     },
     "assignee": {
      "description": "Team member name or id; omit for me",
      "type": "string"
     },
     "notes": {
      "type": "string"
     }
    },
    "required": [
     "title"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "update_task",
   "description": "Edit a task (title, date, time, length, priority) or mark it done. Set time to \"\" to make it untimed again.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "time": {
      "description": "Start time HH:mm, or \"\" to remove",
      "anyOf": [
       {
        "type": "string",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "description": "Time as 24h HH:mm"
       },
       {
        "type": "string",
        "const": ""
       }
      ]
     },
     "durationMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 1440
     },
     "priority": {
      "type": "string",
      "enum": [
       "low",
       "normal",
       "high"
      ]
     },
     "status": {
      "type": "string",
      "enum": [
       "todo",
       "in_progress",
       "done"
      ]
     },
     "notes": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "create_workpaper",
   "description": "Track a work paper. myRole 'preparer' = I execute it; 'reviewer' = I review someone else's.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "engagement": {
      "type": "string"
     },
     "ref": {
      "type": "string",
      "description": "WP reference, e.g. B.2"
     },
     "title": {
      "type": "string"
     },
     "myRole": {
      "type": "string",
      "enum": [
       "preparer",
       "reviewer"
      ]
     },
     "workstream": {
      "description": "Workstream name, e.g. NWC",
      "type": "string"
     },
     "preparer": {
      "description": "Preparer's name when I'm the reviewer",
      "type": "string"
     },
     "reviewer": {
      "description": "Reviewer's name when I'm the preparer",
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "not_started",
       "in_progress",
       "prepared",
       "in_review",
       "points_raised",
       "cleared",
       "final"
      ]
     },
     "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     }
    },
    "required": [
     "engagement",
     "ref",
     "title",
     "myRole"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "update_workpaper_status",
   "description": "Move a work paper through: not_started → in_progress → prepared → in_review → points_raised → cleared → final.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "workpaper": {
      "type": "string",
      "description": "WP id or ref"
     },
     "engagement": {
      "description": "Needed if the ref exists on several engagements",
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "not_started",
       "in_progress",
       "prepared",
       "in_review",
       "points_raised",
       "cleared",
       "final"
      ]
     }
    },
    "required": [
     "workpaper",
     "status"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "add_review_points",
   "description": "Add one or more review points (review notes) to a work paper. Sets the WP to points_raised.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "workpaper": {
      "type": "string",
      "description": "WP id or ref"
     },
     "engagement": {
      "type": "string"
     },
     "points": {
      "minItems": 1,
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "raisedBy": {
      "description": "Who raised them; omit for me",
      "type": "string"
     },
     "assignedTo": {
      "description": "Who must address them; omit for me",
      "type": "string"
     }
    },
    "required": [
     "workpaper",
     "points"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "update_review_point",
   "description": "Mark a review point addressed or cleared (or reopen it).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "open",
       "addressed",
       "cleared"
      ]
     }
    },
    "required": [
     "id",
     "status"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "add_irl_items",
   "description": "Add items to an engagement's information request list (IRL), e.g. from a pasted email or screenshot. Next chase dates are set automatically.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "engagement": {
      "type": "string"
     },
     "requestedFrom": {
      "description": "Client contact's name; created if new",
      "type": "string"
     },
     "requestedOn": {
      "description": "Defaults to today",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "items": {
      "minItems": 1,
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "number": {
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "due": {
         "type": "string",
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "description": "Date as YYYY-MM-DD"
        }
       },
       "required": [
        "description"
       ]
      }
     }
    },
    "required": [
     "engagement",
     "items"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "update_irl_item",
   "description": "Update an IRL item: mark received/partial/na, change due date or add notes.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "pending",
       "partial",
       "received",
       "na"
      ]
     },
     "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     },
     "notes": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "log_chase",
   "description": "Record that I chased an IRL item or nudged someone on a follow-up today. Moves the next chase date forward.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "ids": {
      "minItems": 1,
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "IRL item or follow-up ids"
     }
    },
    "required": [
     "ids"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "create_followup",
   "description": "Track something I'm waiting on from a client, manager or team member.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "about": {
      "type": "string",
      "description": "What I'm waiting for"
     },
     "person": {
      "type": "string"
     },
     "type": {
      "description": "Defaults from the person's role",
      "type": "string",
      "enum": [
       "client",
       "manager",
       "team",
       "other"
      ]
     },
     "engagement": {
      "type": "string"
     },
     "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date as YYYY-MM-DD"
     }
    },
    "required": [
     "about"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "close_followup",
   "description": "Mark a follow-up done (I got what I was waiting for).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "create_alert",
   "description": "Set a reminder that pops up at a given local date and time.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string"
     },
     "at": {
      "type": "string",
      "description": "Local date-time, e.g. 2026-10-20T16:00"
     },
     "itemId": {
      "description": "Record the reminder is about",
      "type": "string"
     }
    },
    "required": [
     "title",
     "at"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "log_time",
   "description": "Log time worked, against an engagement and optionally a task. Use for timesheet hours.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440,
      "description": "Duration in minutes (e.g. 90 for 1.5h)"
     },
     "date": {
      "description": "Defaults to today",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "engagement": {
      "description": "Engagement id or name; omit for admin/other time",
      "type": "string"
     },
     "taskId": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "minutes"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "weekly_report",
   "description": "Summary for a week: items finished, chases, focus sessions, hours by engagement, a timesheet grid, longest-waiting items, overdue count.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "weekOf": {
      "description": "Any date in the week; defaults to this week",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     }
    }
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false
   }
  },
  {
   "name": "get_stats",
