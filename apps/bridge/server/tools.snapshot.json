  },
  {
   "name": "update_program_item",
   "description": "Update a work-programme step: preparer status, reviewer outcome (ok / flagged / na) with a note, notes, or assignee.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "todo",
       "in_progress",
       "done",
       "na"
      ]
     },
     "review": {
      "type": "string",
      "enum": [
       "none",
       "ok",
       "flagged",
       "na"
      ]
     },
     "reviewNote": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "assignee": {
      "description": "Team member name, or 'me'",
      "type": "string"
     }
    },
    "required": [
     "id"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false
   }
  },
  {
   "name": "get_workload",
   "description": "Everything one person has to complete (or 'me'), optionally on one engagement: work plan steps where they are the person responsible, steps waiting for their review, work papers they prepare or review, tasks, review points assigned to them and work-programme procedures. Use for 'how many items / work papers / steps does X have', 'what is pending with X'.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "person": {
